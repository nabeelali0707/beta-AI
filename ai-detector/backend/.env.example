# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME=Beta-AI Backend

# Database
DATABASE_URL=sqlite+aiosqlite:///./test.db
# For production with PostgreSQL via Supabase:
# DATABASE_URL=postgresql://postgres.ttymppqnkikzysfawawl:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.ttymppqnkikzysfawawl:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Security
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Configuration
SUPABASE_URL=https://ttymppqnkikzysfawawl.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# API Keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Model Configuration
AI_DETECTION_MODEL_NAME=roberta-base-openai-detector
SUMMARIZATION_MODEL_NAME=google/flan-t5-small

# Storage
STORAGE_BUCKET=beta-ai-files
MAX_UPLOAD_SIZE_MB=50

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:8001"]

# Application
HOST=0.0.0.0
PORT=8001
RELOAD=true
